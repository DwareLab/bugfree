DATABASE_URL=postgres://bugfree:bugfree@localhost:5442/bugfree
PORT=4100
# Public URL of this API (used in DSNs)
API_URL=http://localhost:4100
# Dashboard origin(s), comma-separated (CORS + CSRF origin check)
APP_URL=http://localhost:3100
# Production: share the session cookie between app. and api. subdomains
# COOKIE_DOMAIN=.example.com
# COOKIE_SECURE=true
RETENTION_DAYS=30
INGEST_RATE_LIMIT=50
# Email alerts (optional), e.g. smtp://user:pass@smtp.example.com:587
# SMTP_URL=
# ALERT_FROM=bugfree <alerts@example.com>
