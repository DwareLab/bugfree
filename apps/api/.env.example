DATABASE_URL=postgres://bugfree:bugfree@localhost:5442/bugfree
PORT=4100
# Public URL of this API (used in DSNs)
API_URL=http://localhost:4100
# Dashboard origin(s), comma-separated (CORS + CSRF origin check)
APP_URL=http://localhost:3100
# Production: share the session cookie between app. and api. subdomains
# COOKIE_DOMAIN=.example.com
# COOKIE_SECURE=true
# Events older than this are deleted (issue counters and charts are kept)
RETENTION_DAYS=30
# Container log lines older than this are deleted
LOG_RETENTION_DAYS=14
# Source maps of releases with no uploads or events for this many days are deleted,
# except each project's ARTIFACT_KEEP_RELEASES newest releases
ARTIFACT_RETENTION_DAYS=90
ARTIFACT_KEEP_RELEASES=5
# Per project, per second (bursts up to 10x)
INGEST_RATE_LIMIT=50
LOG_RATE_LIMIT=2000
# Behind more than one reverse proxy hop: number of hops, or an Express trust-proxy value
# TRUST_PROXY=1
# Email alerts (optional), e.g. smtp://user:pass@smtp.example.com:587
# SMTP_URL=
# ALERT_FROM=bugfree <alerts@example.com>
