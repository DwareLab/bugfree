{
  "name": "@dwarelab/bugfree-core",
  "version": "0.1.0",
  "description": "Platform-agnostic core of the bugfree SDKs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DwareLab/bugfree.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/DwareLab/bugfree#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
