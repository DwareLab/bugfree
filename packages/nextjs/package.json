{
  "name": "@dwarelab/bugfree-nextjs",
  "version": "0.1.0",
  "description": "bugfree SDK for Next.js (App Router)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dwarelab/bugfree-browser": "0.1.0",
    "@dwarelab/bugfree-core": "0.1.0",
    "@dwarelab/bugfree-node": "0.1.0"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.3.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DwareLab/bugfree.git",
    "directory": "packages/nextjs"
  },
  "homepage": "https://github.com/DwareLab/bugfree#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "error-tracking",
    "sentry-alternative",
    "self-hosted",
    "bugfree",
    "nextjs",
    "react"
  ],
  "author": "DwareLab",
  "bugs": {
    "url": "https://github.com/DwareLab/bugfree/issues"
  }
}
