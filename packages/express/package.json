{
  "name": "@dwarelab/bugfree-express",
  "version": "0.1.0",
  "description": "bugfree SDK for Express",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dwarelab/bugfree-core": "0.1.0",
    "@dwarelab/bugfree-node": "0.1.0"
  },
  "peerDependencies": {
    "express": "^4.17.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DwareLab/bugfree.git",
    "directory": "packages/express"
  },
  "homepage": "https://github.com/DwareLab/bugfree#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "error-tracking",
    "sentry-alternative",
    "self-hosted",
    "bugfree",
    "express"
  ],
  "author": "DwareLab",
  "bugs": {
    "url": "https://github.com/DwareLab/bugfree/issues"
  }
}
