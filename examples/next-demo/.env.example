# From the project's settings page in the dashboard
NEXT_PUBLIC_BUGFREE_DSN=http://<public_key>@localhost:4100/<project_id>
# Baked into the build and used for the source map upload
BUGFREE_RELEASE=next-demo@0.1.0
# For `npm run upload-sourcemaps`
BUGFREE_URL=http://localhost:4100
BUGFREE_AUTH_TOKEN=<project secret key>
